# Every variable is OPTIONAL for running the app locally. Copy this file to .env only if you
# want to change a default. The server and the Vite dev server both read .env from this folder.

# MongoDB connection string. If unset, the server starts a temporary built-in database filled
# with demo data, which is wiped every time the server restarts.
# MONGO_URL=mongodb://127.0.0.1:27017/bloodbank

# Secret for signing login tokens. If unset, a random one is generated on each start
# (everyone is logged out when the server restarts).
# JWT_SECRET=replace-with-a-long-random-string

# Port for the API server (and for the built app after `npm run build`). Default: 8080.
# PORT=8080

# Set to "production" when deploying. Production requires MONGO_URL and JWT_SECRET.
# NODE_ENV=production
