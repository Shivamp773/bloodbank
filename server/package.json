{
  "name": "@bloodbank/server",
  "version": "2.0.0",
  "private": true,
  "description": "REST API for the Blood Bank app (Express 5 + Mongoose).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-preserve-output server.js",
    "seed": "node seed/seed.js",
    "create-admin": "node seed/createAdmin.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
